# Copy to .env and fill in what you need. Everything is optional for local use.

# ── Server ───────────────────────────────────────────────
PORT=8787
# Public URL users open in the browser. In `npm run dev` this is the Vite URL;
# for `npm start` use http://localhost:8787 (used for GitHub OAuth redirects and secure cookies).
APP_URL=http://localhost:5173
# NODE_ENV=production
# Interface to listen on (default 127.0.0.1, or 0.0.0.0 when NODE_ENV=production)
# HOST=127.0.0.1
# Where SQLite, generated secrets and temporary scan files live (default ./data)
# DATA_DIR=./data
# TMP_DIR=./data/tmp
# Built web UI to serve (default ./web/dist)
# WEB_DIST=./web/dist
# Session cookie lifetime in days
SESSION_DAYS=7
# Comma-separated Host headers to accept (blocks DNS rebinding); empty = any. The desktop app sets this.
ALLOWED_HOSTS=

# ── Database ─────────────────────────────────────────────
# Empty = SQLite file in ./data (perfect for localhost / desktop).
# Cloud: a PostgreSQL URL, e.g. from Neon (free): postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# ── Secrets (REQUIRED in production; auto-generated locally into data/secrets.json) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ENC_KEY=

# ── AI engines (server-wide defaults; users can also add their own keys in Settings) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── GitHub ───────────────────────────────────────────────
# OAuth app (github.com/settings/developers). Callback URL: <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for higher GitHub API rate limits on repo downloads
GITHUB_TOKEN=

# ── Limits ───────────────────────────────────────────────
# The web UI also refuses selections over 100 MB.
MAX_UPLOAD_MB=100
MAX_UNZIPPED_MB=300
MAX_FILES=20000
MAX_FILE_KB=1024
CONCURRENT_SCANS=2
ALLOW_REGISTRATION=true
# Set to 1 only when running behind a reverse proxy / load balancer (Render, nginx)
TRUST_PROXY=
# Set to false to skip the OSV.dev dependency CVE lookup (fully offline)
OSV_ENABLED=true

# ── docker compose only ──────────────────────────────────
# Password for the bundled PostgreSQL container (docker-compose.yml)
POSTGRES_PASSWORD=
